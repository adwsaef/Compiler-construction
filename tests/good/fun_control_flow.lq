def reached_two(n: int) -> int:
    print(n)
    return n if n == 2 else 0

def twice(n: int) -> int:
    return n * 2

def search(n: int, add_one: bool) -> int:
    while n > 0:
        if reached_two(n) != 0:
            return twice(input_int() + 1) if add_one else twice(input_int() - 1)
            print(99)
